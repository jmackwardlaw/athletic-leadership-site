# ─────────────────────────────────────────────────────────────
# Palmetto AL Hub — frontend env vars (Vite)
# Copy to `.env.local` and fill in. These ship in the client bundle;
# Firebase web config is NOT secret. Real secrets live in Cloud
# Functions config, never here.
# In production these are set in the Vercel project's Environment Variables.
# ─────────────────────────────────────────────────────────────

# Firebase web app config (Project settings → General → Your apps → Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated list of allowed Google Workspace domains for sign-in.
# This is a UX/early-out check only — the real boundary is the
# ensureProfile Cloud Function + Firestore security rules.
VITE_ALLOWED_AUTH_DOMAINS=apps.anderson1.org

# Optional: point callable functions at a non-default region (defaults to us-central1)
# VITE_FIREBASE_FUNCTIONS_REGION=us-central1
